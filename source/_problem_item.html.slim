.accordion-item
  h2.accordion-header
    button.accordion-button.collapsed[type="button" data-bs-toggle="collapse" data-bs-target="#ProblemItem#{id}" aria-expanded="false" aria-controls="ProblemItem#{id}"]
      .px-2
        i.bi.bi-arrow-right
      = title
  .accordion-collapse.collapse[id="ProblemItem#{id}"]
    .accordion-body
      = yield



